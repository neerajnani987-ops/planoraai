# ==============================================================================
# Planora AI Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In Vercel, configure these under Project Settings > Environment Variables.
# NEVER commit .env.local or sensitive credentials to Git source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API (Server-side ONLY - NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 2. Application Canonical URL
# ------------------------------------------------------------------------------
# Local development: http://localhost:3000
# Vercel production: https://planoraai-pink.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Firebase Client Configuration (Browser / Client-side)
# Obtain these from: Firebase Console > Project Settings > General > Your Apps > Web App
# ------------------------------------------------------------------------------
# [REQUIRED] Web API key for client-side Auth and Firestore
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here
# [REQUIRED] Auth domain (e.g., planora-ai-f3e0b.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=planora-ai-f3e0b.firebaseapp.com
# [REQUIRED] Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=planora-ai-f3e0b
# [OPTIONAL] Storage bucket for media uploads
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=planora-ai-f3e0b.firebasestorage.app
# [OPTIONAL] Cloud Messaging sender ID (from Firebase Console)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
# [OPTIONAL] Firebase Web App ID (from Firebase Console)
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id_here

# ------------------------------------------------------------------------------
# 4. Firebase Admin SDK Configuration (Server-side ONLY - NEVER prefix with NEXT_PUBLIC_)
# Obtain from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=planora-ai-f3e0b
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@planora-ai-f3e0b.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. Local Emulator Configuration (Optional)
# Set to 'true' to redirect Auth and Firestore to local emulators (localhost:9099, localhost:8080)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

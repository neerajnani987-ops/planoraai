# ==========================================
# Planora AI Environment Configuration
# ==========================================

# 1. Google Gemini AI API (Server-side only - NEVER prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 2. Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Firebase Client Configuration (Browser / Client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=planora-ai-f3e0b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=planora-ai-f3e0b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=planora-ai-f3e0b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# 4. Firebase Admin SDK Configuration (Server-side ONLY - NEVER prefix with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=planora-ai-f3e0b
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@planora-ai-f3e0b.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# 5. Local Emulator Configuration (Optional - set to 'true' to use local Firebase emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
